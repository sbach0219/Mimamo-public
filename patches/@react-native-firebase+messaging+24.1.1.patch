@@ -143,6 +143,16 @@ - (void)userNotificationCenter:(UNUserNotificationCenter *)center
     [_originalDelegate userNotificationCenter:center
                       willPresentNotification:notification
                         withCompletionHandler:completionHandler];
+
+    // Notifications that did not come from FCM belong to whoever was the
+    // delegate before us (expo-notifications, for example). Their presentation
+    // decision is asynchronous, so calling the completion handler below would
+    // always win the race and silently force
+    // `messaging_ios_foreground_presentation_options` - which defaults to none -
+    // onto notifications this library does not own.
+    if (notification.request.content.userInfo[@"gcm.message_id"] == nil) {
+      return;
+    }
   }
 
